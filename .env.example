# Plantilla de variables de entorno. NO contiene secretos reales.
#
# Para trabajar en local, copia este archivo como .env.local y rellena los valores.
# .env.local esta ignorado por git (regla "*.local" del .gitignore), asi que tus
# claves nunca se suben al repositorio.

# --- Claves publicas (seguras en el navegador: van al bundle del cliente y RLS las protege) ---
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- SECRETOS (dejar comentados salvo que uses el copiloto de IA en local) ---
# NUNCA les pongas prefijo VITE_ (se filtrarian al navegador) ni los subas a git.
# Solo los necesita `npm run dev` en tu PC; en GitHub Pages no se usan.
#
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"  # acceso TOTAL a la BD, ignora RLS
# LOVABLE_API_KEY="xxxxxxxxxxxxxxxxxxxx"                       # consume tus creditos de IA